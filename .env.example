# Copy to .env and change these before running anywhere other than your own machine.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
POSTGRES_PASSWORD=replace-with-a-strong-password
# Shared secret the game server uses to report online results to Django.
GAME_SERVER_KEY=replace-with-another-long-random-string
# Add your domain if you host it, e.g. DJANGO_ALLOWED_HOSTS=game.example.com ("web" is added automatically).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
